{
  "name": "@promption/ai-sdk",
  "version": "1.1.0",
  "description": "Promption input, output and tool protection as Vercel AI SDK middleware",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "ai": "^6.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:types": "tsc --noEmit --strict --skipLibCheck --target es2022 --module nodenext test/types.ts"
  },
  "devDependencies": {
    "ai": "^6.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0"
  }
}
