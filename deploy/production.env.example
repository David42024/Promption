# Guardar cada sección en ~/.config/promption/{filter,chat,web}.env con permisos 600.
# Generar claves diferentes y aleatorias. Nunca guardar las claves reales en Git.

# filter.env
PROMPTION_ENV=production
PROMPTION_DEMO_MODE=false
PROMPTION_API_KEYS=promption-shop:REEMPLAZAR_CLAVE_FILTRO
PROMPTION_ADMIN_API_KEYS=platform:REEMPLAZAR_CLAVE_ADMIN
PROMPTION_CORS_ORIGINS=https://promption.incubunt.com

# chat.env
DEBUG=false
FILTER_API_URL=http://127.0.0.1:8100
PROMPTION_API_KEY=REEMPLAZAR_CLAVE_FILTRO
TENANT_ID=promption-shop
CHAT_SERVICE_TOKEN=REEMPLAZAR_TOKEN_INTERNO
VERCEL_AI_URL=http://127.0.0.1:3100/api/ai/turn
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TOOL_MODEL=gpt-5.4-mini
LLM_PROVIDER_ORDER=openai
STORAGE_BACKEND=sqlite
SQLITE_DB_PATH=/home/incutiicito/.local/share/promption/conversations.db
SECURITY_STATE_PATH=/home/incutiicito/.local/share/promption/security-state.json
WORKERS=1
CORS_ORIGINS_STR=https://promption.incubunt.com

# web.env
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
CHAT_API_URL=http://127.0.0.1:8101
PIF_API_URL=http://127.0.0.1:8100
SITE_URL=https://promption.incubunt.com
CHAT_SERVICE_TOKEN=REEMPLAZAR_TOKEN_INTERNO
SESSION_SECRET=REEMPLAZAR_SECRETO_SESION
PROMPTION_ADMIN_API_KEY=REEMPLAZAR_CLAVE_ADMIN
OPENAI_API_KEY=REEMPLAZAR_CLAVE_OPENAI
OPENAI_MODEL=gpt-5.4-nano
OPENAI_TOOL_MODEL=gpt-5.4-mini
