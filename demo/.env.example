# ==================== VARIABLES DE ENTORNO ====================
# Copia este archivo a .env.local para desarrollo local
# Nunca commitees keys reales en el repositorio

# ==================== BACKEND (Render) ====================
# URL de la API del filtro (en producción es la misma URL del backend)
PIF_API_URL=https://promption.onrender.com

# Key del tenant demo-shop (ver config/tenants.yaml del backend)
PIF_TENANT_KEY=pif_demo_shop_123456
PIF_TENANT_ID=demo-shop

# Groq API Key (https://console.groq.com/keys)
GROQ_API_KEY=gsk_TU_KEY_AQUI

# OpenRouter API Key (opcional, como backup)
OPENROUTER_API_KEY=sk-or-TU_KEY_AQUI

# Modelo LLM a usar
PIF_LLM_MODEL=llama-3.1-70b-versatile

# Admin secret para panel de administración (CAMBIAR EN PRODUCCIÓN)
PIF_ADMIN_SECRET=tu_secret_super_seguro_12345

# ==================== FRONTEND (Vercel) ====================
# Variables con NEXT_PUBLIC_ para estar disponibles en el cliente
NEXT_PUBLIC_PIF_API_URL=https://promption.onrender.com
NEXT_PUBLIC_PIF_ADMIN_SECRET=tu_secret_super_seguro_12345
