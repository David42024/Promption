# Copia a .env (nunca commitees keys reales)
# API del filtro (FastAPI del repo): uvicorn src.api.main:app --port 8000
PIF_API_URL=http://localhost:8000
# Key del tenant demo-shop (ver config/tenants.yaml)
PIF_TENANT_KEY=pif_demo_shop_123456
PIF_TENANT_ID=demo-shop
# Groq (https://console.groq.com/keys)
GROQ_API_KEY=gsk_TU_KEY_AQUI
# Modelo demo: chico y dócil para que la demo de inyección funcione
PIF_LLM_MODEL=openai/gpt-oss-20b
# Admin secret para panel de administración (CAMBIAR EN PRODUCCIÓN)
PIF_ADMIN_SECRET=admin_secret_change_me
